{
  "name": "metricpanel-js",
  "version": "0.0.0",
  "private": true,
  "description": "Public release mirror for MetricPanel JavaScript packages",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run verify:mirror && turbo run check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint:check": "turbo run lint:check",
    "format:check": "turbo run format:check",
    "verify:mirror": "bun scripts/verify-mirror.ts",
    "verify:packages": "bun scripts/verify-package-tarballs.ts"
  },
  "devDependencies": {
    "turbo": "2.10.7"
  }
}
