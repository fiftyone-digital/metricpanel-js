{
  "name": "@metricpanel/sdk",
  "version": "1.1.3",
  "description": "Official browser and React Native SDK for MetricPanel analytics",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "browser": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.cjs",
      "default": "./dist/react-native.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.ts",
    "react-native.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && tsc -p tsconfig.json",
    "build:esm": "bun build ./index.ts ./react-native.ts --outdir ./dist --format esm --target browser --entry-naming='[name].mjs' --sourcemap=external",
    "build:cjs": "bun build ./index.ts ./react-native.ts --outdir ./dist --format cjs --target node --entry-naming='[name].cjs' --sourcemap=external",
    "dev": "bun build ./index.ts ./react-native.ts --outdir ./dist --format esm --target browser --entry-naming='[name].mjs' --sourcemap=external --watch",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check && bun run build",
    "check": "bun run lint:check && bun run test && bun run typecheck && bun run format:check",
    "lint:check": "eslint index.ts react-native.ts --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "analytics",
    "tracking",
    "metrics",
    "metricpanel",
    "privacy",
    "gdpr"
  ],
  "author": {
    "name": "FiftyOne Digital",
    "url": "https://fiftyone.dev"
  },
  "license": "MIT",
  "homepage": "https://metricpanel.io/docs/sdk",
  "bugs": {
    "url": "https://github.com/fiftyone-digital/metricpanel-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiftyone-digital/metricpanel-js.git",
    "directory": "packages/sdk"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "happy-dom": "^20.11.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "packageManager": "bun@1.3.8",
  "sideEffects": false
}
